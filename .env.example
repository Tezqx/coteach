# Copy this file to .env and fill in a key:
#   cp .env.example .env
#
# Provider: gemini (default, free key from Google AI Studio) or openai
LLM_PROVIDER=gemini

# Model name. Defaults: gemini-2.5-flash (gemini) or gpt-4o-mini (openai)
LLM_MODEL=gemini-3.5-flash

# Required for live Gemini requests (the default provider).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required only if LLM_PROVIDER=openai
# Get a key at https://platform.openai.com/api-keys (billing credit needed)
OPENAI_API_KEY=

# Optional. SQLite file location. In Docker / Hugging Face Spaces this defaults
# to /tmp/coteach.db (or /data/coteach.db when that directory is writable).
# Locally it defaults to data/teachercoach.db.
# DB_PATH=

# Optional. PostgreSQL connection string (e.g. free Neon or Supabase).
# When set, it is used instead of SQLite and tables are created on startup.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
